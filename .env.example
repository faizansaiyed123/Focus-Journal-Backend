# Copy this file to .env locally. Generate both secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PROJECT_NAME=Focus Journal
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://focus_journal:change-me@localhost:5432/focus_journal
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_SECRET_KEY=replace-with-another-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,https://focus-journal-frontend.vercel.app
FRONTEND_BASE_URL=http://localhost:5173

# Optional integrations. Configure only providers that are enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=
LINKEDIN_SCOPE=openid profile email
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
